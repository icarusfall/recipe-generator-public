# Copy this file to .env for local use. On Railway, set these under your service's Variables tab.

# Your Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The passphrase your household types to get in. Changing it signs everyone out.
APP_PASSPHRASE=

# Optional: which Claude model to use (default: claude-opus-5-5)
# MODEL=claude-sonnet-5-5

# Optional: cap on Claude requests per hour across the whole household (default: 100)
# CLAUDE_REQUESTS_PER_HOUR=100

# Optional: where the database lives. On Railway this is picked up automatically from an attached volume.
# DATA_DIR=./data
